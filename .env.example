# DealGenie Environment Configuration
# =================================
# Copy this file to .env and update with your credentials

# Database
DATABASE_URL=postgresql://YOUR_USERNAME@localhost/dealgenie_production

# Monte Carlo Feature Flags
MONTE_CARLO_ENABLED=false
CAPTURE_SIM_INPUTS=true

# Monte Carlo Defaults
MC_DEFAULT_RUNS=1000
MC_DEFAULT_SEED=42
MC_SIM_VERSION=1

# Application
APP_NAME=DealGenie
DEBUG=false
